# Docker: UID/GID used inside the containers — match your host user (`id -u` / `id -g`)
USER_ID=1000
USER_GID=1000

# Core API — every value below is optional; the defaults are the ones shown.
CORE_SERVER_HOST=0.0.0.0
CORE_SERVER_PORT=80
DEV_MODE=true
DATABASE_URL=postgresql://admin:admin@db:5432/db

# Anthropic API (AI feedback on the daily journal). Leave the key empty to disable the feature.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
